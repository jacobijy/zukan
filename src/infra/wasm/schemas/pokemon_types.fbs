// data/v2/fb/schemas/pokemon_types.fbs
//
// 宝可梦双属性槽。
// 对应 CSV：data/v2/csv/by_generation/pokemon_types.csv
//          + gen-N/pokemon_types_diff.csv
//
// 本文件只定义 struct（固定尺寸行记录），顶层 root 见
// pokemon_gen_bundle.fbs。
//
// 字段范围：
//   id: 1..10326
//   type_1_id: 1..18  (18 种主属性)
//   type_2_id: 0..18  (0 = 无第二属性)

namespace pokeapi.fb;

struct PokemonType {
  id: uint32;
  type_1_id: uint8;
  type_2_id: uint8;
}
