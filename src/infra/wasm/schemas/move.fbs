// data/v2/fb/schemas/move.fbs
//
// 招式主表单行记录。对应 CSV：
//   data/v2/csv/by_version_group/common/moves.csv         (基线)
//   data/v2/csv/by_version_group/vg-XX/moves_diff.csv     (VG 差异)
//
// 只保留数值列；identifier slug 剥离。
//
// 字段范围（全表扫描）：
//   id: 1..10018 (含 alt-form 10000+)
//   generation_id: 1..9
//   type_id: 1..10002 (含 shadow-type 等 alt-type)
//   power: 0..250 (0 = CSV 空，如 splash / dragon-rage)
//   pp: 0..40 (0 = CSV 空)
//   accuracy: 0..100 (0 = CSV 空，如 swift 必中)
//   priority: -7..5 (需要有符号)
//   target_id: 1..16
//   damage_class_id: 1..3 (1=status 2=physical 3=special)
//   effect_id: 1..10006 (0 = CSV 空)
//   effect_chance: 0..100
//   contest_type_id: 0..5 (0 = 无大赛数据)
//   contest_effect_id: 0..33
//   super_contest_effect_id: 0..23

namespace pokeapi.fb;

struct Move {
  id: uint32;
  generation_id: uint8;
  type_id: uint16;
  power: uint8;
  pp: uint8;
  accuracy: uint8;
  priority: int8;
  target_id: uint8;
  damage_class_id: uint8;
  effect_id: uint16;
  effect_chance: uint8;
  contest_type_id: uint8;
  contest_effect_id: uint8;
  super_contest_effect_id: uint8;
}
